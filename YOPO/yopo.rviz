Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Trajectory1
        - /Trajectory1/All Trajectories1/Topic1
        - /Trajectory1/Lattice Primitives1/Topic1
        - /Trajectory1/TrackerPath1/Topic1
        - /Target1
        - /Target1/Target Pred1/Topic1
        - /Target1/Target EKF1/Topic1
        - /Target1/TargetPath1/Topic1
        - /Image1
        - /Image1/Target Image1/Topic1
        - /Image1/Camera1/Topic1
        - /Tracker UAV1/Topic1
        - /PointCloud21/Autocompute Value Bounds1
      Splitter Ratio: 0.5
    Tree Height: 728
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 15
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 90
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 75
        Y: -75
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: Best Trajectory
          Namespaces:
            "": true
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/best_traj_visual
          Value: true
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: All Trajectories
          Namespaces:
            {}
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/trajs_visual
          Value: false
        - Class: rviz_default_plugins/MarkerArray
          Enabled: false
          Name: Lattice Primitives
          Namespaces:
            {}
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/lattice_trajs_visual
          Value: false
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 53; 132; 228
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Billboards
          Line Width: 0.10000000149011612
          Name: TrackerPath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /drone_0/path
          Value: true
      Enabled: true
      Name: Trajectory
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Axes Length: 0.05000000074505806
          Axes Radius: 0.5
          Class: rviz_default_plugins/Pose
          Color: 255; 25; 0
          Enabled: true
          Head Length: 0.30000001192092896
          Head Radius: 0.10000000149011612
          Name: Target Pred
          Shaft Length: 1
          Shaft Radius: 0.05000000074505806
          Shape: Axes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/target_pred
          Value: true
        - Alpha: 1
          Axes Length: 0.800000011920929
          Axes Radius: 0.10000000149011612
          Class: rviz_default_plugins/Pose
          Color: 255; 25; 0
          Enabled: true
          Head Length: 0.30000001192092896
          Head Radius: 0.10000000149011612
          Name: Target EKF
          Shaft Length: 1
          Shaft Radius: 0.05000000074505806
          Shape: Axes
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/target_ekf
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 246; 97; 81
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Billboards
          Line Width: 0.10000000149011612
          Name: TargetPath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /character_0/path
          Value: true
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: Target Sim
          Namespaces:
            mesh: true
          Topic:
            Depth: 1
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /character_0/mesh
          Value: true
      Enabled: true
      Name: Target
    - Class: rviz_common/Group
      Displays:
        - Class: rviz_default_plugins/Image
          Enabled: false
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Target Image
          Normalize Range: true
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /yopo_net/target_image
          Value: false
        - Class: rviz_default_plugins/Image
          Enabled: false
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: RGB
          Normalize Range: true
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /drone_0/rgb
          Value: false
        - Class: rviz_default_plugins/Camera
          Enabled: true
          Far Plane Distance: 100
          Image Rendering: background and overlay
          Name: Camera
          Overlay Alpha: 0.5
          Topic:
            Depth: 1
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /drone_0/rgb
          Value: true
          Visibility:
            Grid: false
            Image:
              RGB: false
              Target Image: false
              Value: true
            PointCloud2: false
            Target:
              Target EKF: false
              Target Pred: true
              Target Sim: false
              TargetPath: false
              Value: true
            Tracker UAV: false
            Trajectory:
              All Trajectories: true
              Best Trajectory: true
              Lattice Primitives: true
              TrackerPath: false
              Value: true
            Value: true
          Zoom Factor: 1
      Enabled: true
      Name: Image
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Tracker UAV
      Namespaces:
        mesh: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /uav
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 6
        Min Value: -8
        Value: false
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 3
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 16.577817916870117
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: PointCloud2
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.10000000149011612
      Style: Flat Squares
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 29.963539123535156
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.38987135887146
        Y: -6.44293212890625
        Z: 16.360023498535156
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.1397967338562012
      Target Frame: odom
      Value: Orbit (rviz_default_plugins)
      Yaw: 5.478700160980225
    Saved: ~
